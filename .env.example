# ==============================================================================
# KLYVO BY KLYSCAPE — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to `.env` for local development. Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Public Configuration (Vite exposes VITE_* variables to the browser)
# Leave blank during local preview; populate to connect Supabase Auth, Database,
# and Storage. The publishable key is safe for browser use when RLS is enabled.
# ------------------------------------------------------------------------------
VITE_APP_NAME="Klyvo"
VITE_PARENT_BRAND="Klyscape"
VITE_API_BASE_URL="/api"

# Supabase Public Client Config (Safe to expose publicly; protected by Postgres RLS)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ------------------------------------------------------------------------------
# Server-Side Configuration & Secrets (Server Runtime / Netlify Functions ONLY — NEVER prefix with VITE_)
# Configure these in Google AI Studio Secrets (for AI Studio runtime) or Netlify Site Settings.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
# Optional Gemini chat model override (defaults to gemini-3.5-flash-lite on the server)
GEMINI_MODEL="gemini-3.5-flash-lite"
# Optional thinking level override (defaults to minimal for gemini-3.5-flash-lite)
GEMINI_THINKING_LEVEL="minimal"
# Optional server-side timeouts in milliseconds
GEMINI_REQUEST_TIMEOUT_MS="15000"
GEMINI_FIRST_TEXT_TIMEOUT_MS="30000"
GEMINI_STREAM_IDLE_TIMEOUT_MS="25000"
GEMINI_MAX_STREAM_DURATION_MS="180000"
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Optional best-effort per-instance rate limit (defaults to 20 requests/min)
KLYVO_MAX_REQUESTS_PER_MINUTE="20"
